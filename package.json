{
  "name": "huehop",
  "version": "1.0.0",
  "private": true,
  "description": "Hue Hop: tap-to-bounce colour matching arcade game (PWA + Capacitor iOS wrapper)",
  "scripts": {
    "start": "npx --yes serve www -l 8080",
    "icons": "python3 tools/make_icons.py",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@capacitor/ios": "^6.1.0"
  }
}
